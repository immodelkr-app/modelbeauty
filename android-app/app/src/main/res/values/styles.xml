<resources>
    <!-- 타이틀바가 없는 앱 테마 정의 (웹뷰를 화면 가득 채우기 위함) -->
    <style name="Theme.ModelBeauty" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 기본 브랜드 색상 -->
        <item name="colorPrimary">#ec4899</item>
        <item name="colorPrimaryVariant">#db2777</item>
        <item name="colorOnPrimary">#ffffff</item>
        
        <!-- 상태바 색상을 다크네이비(#0f172a)로 통일하여 통일감 부여 -->
        <item name="android:statusBarColor">#0f172a</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 앱 실행 즉시(웹뷰 코드 실행 전) OS가 그려주는 최초 화면 배경.
         액티비티 onCreate가 실행되기도 전에 윈도우 배경으로 바로 표시되어 흰 화면 깜빡임을 없앰 -->
    <style name="Theme.ModelBeauty.Splash" parent="Theme.ModelBeauty">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
